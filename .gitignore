# 비밀키·환경변수 — 절대 커밋 금지
.env
.env.*
*.local
secrets/
*-token.txt
*-key.txt

# 의존성·빌드 산출물
node_modules/
dist/
build/
.next/
*.tsbuildinfo

# 파이프라인 런타임 데이터 (M1에서 정책 재확정)
# raw 수집물·렌더 출력은 용량이 크므로 기본 제외. 샘플/뱅크는 별도 예외 규칙 예정.
data/raw/
data/out/
data/briefs/
data/plans/
data/content/

# 렌더러 임시 HTML (템플릿 폴더에 잠깐 생겼다 삭제됨)
templates/**/.render-tmp-*.html

# 관제탑 생성물 (dashboard-static이 만드는 산출물 — 썸네일 base64 포함 대용량)
# 생성기 소스(packages/dashboard-static)만 커밋하고, 결과물은 필요 시 재생성/CI 배포
packages/dashboard/index.html
packages/dashboard/tower-state.json
packages/dashboard/artifact-body.html
packages/dashboard/thumbs/

# OS·에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 로그
*.log
npm-debug.log*
pnpm-debug.log*

# 관제탑 배포 산출물 (CI가 매 배포마다 재생성)
packages/tower-worker/_site/

# 관제탑 폰트 사본 — 빌드 때 templates/_shared/fonts 에서 복사된다
packages/dashboard/fonts/

# 에이전트 작업용 워크트리 — 저장소에 들어가면 안 된다(내부에 또 다른 git 이다)
.claude/worktrees/

# 청약홈 알림 문구 — 실행 때마다 새로 쓰는 임시 산출물(저장소에 남길 이유가 없다)
data/applyhome-alert.txt
