{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "danji-brief@2",
  "description": "청약단지 브리핑 — 고정 부제(오늘의 주요 청약 이슈 + 날짜) · 한 줄 대제목 · 조감도 · 2칸 스트립 두 줄 · 청약 일정 3칸 · 특이사항. 2026-08-03 오너 지시 재설계.",
  "type": "object",
  "required": [
    "template",
    "topcap",
    "titleLines",
    "danji",
    "strips",
    "source"
  ],
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^danji-brief@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "presale",
        "result"
      ]
    },
    "topcap": {
      "type": "string",
      "maxLength": 40,
      "description": "고정 부제 + 기준 날짜. 빌더가 만든다 — 손으로 적으면 날짜가 굳는다"
    },
    "titleLines": {
      "type": "array",
      "description": "제목. 오너 지시로 **한 줄**이 기본이다(폰트를 최대로 키우기 위해)",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "hero": {
      "type": "object",
      "properties": {
        "photo": {
          "type": "string"
        },
        "credit": {
          "type": "string",
          "maxLength": 40
        },
        "placeholder": {
          "type": "boolean"
        },
        "fallbackColor": {
          "type": "string"
        },
        "fallbackWord": {
          "type": "string",
          "maxLength": 20
        }
      }
    },
    "danji": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "주소·시공사 줄은 오너 지시로 삭제됐다(2026-08-03). 이름과 브랜드 로고만 남는다",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 24
        },
        "logo": {
          "type": "string"
        },
        "logoColor": {
          "type": "string"
        },
        "company": {
          "type": "string",
          "maxLength": 20
        }
      }
    },
    "strips": {
      "type": "array",
      "description": "2칸짜리 줄들. 1줄 = [세대수, 최고층] / 2줄 = [대표평형, 분양가]",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {
          "type": "object",
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 14
            },
            "value": {
              "type": "string",
              "maxLength": 12
            },
            "unit": {
              "type": "string",
              "maxLength": 6
            },
            "hi": {
              "type": "boolean"
            },
            "key": {
              "type": "boolean",
              "description": "코발트 강조(값). 레드(hi)는 상승·과열 시그널 전용이다"
            }
          }
        }
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "label",
          "date"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 10
          },
          "date": {
            "type": "string",
            "maxLength": 12
          },
          "tbd": {
            "type": "boolean"
          }
        }
      }
    },
    "notice": {
      "type": "string",
      "maxLength": 70,
      "description": "특이사항 한 줄 — 분상제·전매제한 등"
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "priceTable": {
      "type": "object",
      "required": [
        "head",
        "rows"
      ],
      "description": "평형별 대표타입 표 — 면적대마다 타입 하나씩, 전부 적는다(오너 지시 2026-08-03)",
      "properties": {
        "head": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 14
          },
          "minItems": 2,
          "maxItems": 2
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "area",
              "price"
            ],
            "properties": {
              "area": {
                "type": "string",
                "maxLength": 10
              },
              "price": {
                "type": "string",
                "maxLength": 12
              },
              "main": {
                "type": "boolean",
                "description": "주력 면적대 — 한 줄만 코발트"
              }
            }
          }
        }
      }
    }
  }
}
