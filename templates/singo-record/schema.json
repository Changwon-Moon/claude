{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "singo-record@1",
  "description": "오늘의 신고가 — 단지 한 곳이 기준선 이후 최고가를 새로 쓴 사건 한 건. 월별 최고가 곡선과 넘어선 10억 선을 함께 그린다. 좌표는 전부 빌더가 계산한다(템플릿은 그리기만).",
  "type": "object",
  "required": [
    "template",
    "title",
    "price",
    "spec",
    "chart",
    "source"
  ],
  "additionalProperties": true,
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^singo-record@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "kicker": {
      "type": "string",
      "maxLength": 48,
      "description": "오늘의 N억 클럽 가입 소식 (날짜). 돌파가 아니면 '클럽 가입'이라 쓰지 않는다."
    },
    "title": {
      "type": "string",
      "description": "단지명 + 평형(<span class=\"py\">, 코발트). 한 줄. ⚠️ 지역은 붙이지 않는다(오너 2026-08-16b) — 지역은 역 뱃지와 캡션이 말하고, meta.region 에 남는다."
    },
    "price": {
      "type": "string",
      "maxLength": 12,
      "description": "실거래가 (예: 20.7억). 이 판형에서 레드로 쓰는 자리."
    },
    "priceSuffix": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 8,
      "description": "가격 옆 한 마디(잉크). 돌파일 때만 '달성!'. 선을 넘지 않은 신고가에는 붙이지 않는다."
    },
    "chart": {
      "type": "object",
      "required": [
        "vb",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "vb": {
          "type": "string"
        },
        "threshold": {
          "type": [
            "object",
            "null"
          ],
          "description": "오늘 값 기준선. **모든 카드에 있다**(2026-08-16c) — 아래 두 기준선이 '무엇과 견줬는지'를 말하려면 견주는 대상인 오늘 값에도 선이 있어야 한다. 돌파 카드도 문턱(10억)이 아니라 오늘 값에 긋는다(정기물에 조건부 예외를 두지 않는다). text 는 오늘 값(예: 6.67억).",
          "required": [
            "x1",
            "x2",
            "y",
            "tx",
            "ty",
            "text"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "tx": {
              "type": "number"
            },
            "ty": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "anchor": {
              "type": "string"
            }
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "description": "선 구간. 수집을 못 한 달에서 끊기므로 여러 개일 수 있다.",
          "items": {
            "type": "object",
            "required": [
              "d"
            ],
            "properties": {
              "d": {
                "type": "string"
              }
            }
          }
        },
        "dots": {
          "type": "array",
          "description": "실제 거래가 있던 달. 선은 관측 사이를 이은 것일 뿐이라 점이 있어야 한다.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "r"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            }
          }
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "text"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "anchor": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "dot": {
          "type": "object",
          "description": "오늘 거래. 카드에서 레드를 쓰는 유일한 자리. 라벨은 없다 — 위 큰 숫자가 이미 말한다.",
          "required": [
            "x",
            "y",
            "r",
            "rOuter"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "rOuter": {
              "type": "number"
            }
          }
        },
        "old": {
          "type": [
            "object",
            "null"
          ],
          "description": "지난 고점이 난 달의 점. tone=hi → 빨강 채움(라벨과 같은 색).",
          "required": [
            "x",
            "y",
            "r"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          }
        },
        "prevLine": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "x1",
            "x2",
            "y",
            "tx",
            "ty1",
            "ty2",
            "text1",
            "text2",
            "tone"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "tx": {
              "type": "number"
            },
            "ty1": {
              "type": "number"
            },
            "ty2": {
              "type": "number"
            },
            "anchor": {
              "type": "string"
            },
            "text1": {
              "type": "string"
            },
            "text2": {
              "type": "string"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          },
          "description": "지난 사이클 고점 선 + 2행 라벨(값(연월) / 고점대비 +N%)."
        },
        "lowLine": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "x1",
            "x2",
            "y",
            "tx",
            "ty1",
            "ty2",
            "text1",
            "text2",
            "tone"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "tx": {
              "type": "number"
            },
            "ty1": {
              "type": "number"
            },
            "ty2": {
              "type": "number"
            },
            "anchor": {
              "type": "string"
            },
            "text1": {
              "type": "string"
            },
            "text2": {
              "type": "string"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          },
          "description": "기준선 이후 최저점 선 + 2행 라벨(값(연월) / 저점대비 +N%). 최우측 정렬."
        },
        "stamp": {
          "type": [
            "object",
            "null"
          ],
          "description": "판 안쪽 워터마크(BRAND.md 슬롯 C). 판 한가운데에 판 대각선 각도로 눕힌다. 크기는 그 각도로 돌린 글자 상자가 판에 들어가는 최대치를 빌더가 계산한다 — 손으로 찍지 않는다.",
          "required": [
            "x",
            "y",
            "size",
            "text",
            "rotate",
            "cx",
            "cy"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "cx": {
              "type": "number"
            },
            "cy": {
              "type": "number"
            },
            "size": {
              "type": "number"
            },
            "rotate": {
              "type": "number"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "bg": {
          "type": "object",
          "description": "판 바탕(옅은 회색).",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "r": {
              "type": "number"
            }
          }
        },
        "lowDot": {
          "type": [
            "object",
            "null"
          ],
          "description": "최저점이 난 달의 점. tone=lo → 파랑 채움(라벨과 같은 색).",
          "required": [
            "x",
            "y",
            "r"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          }
        },
        "brkHi": {
          "type": [
            "object",
            "null"
          ],
          "description": "두 선 사이 폭 표시 직선. 길이가 곧 퍼센트다.",
          "required": [
            "x",
            "y1",
            "y2",
            "tickX1",
            "tickX2",
            "tone"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "tickX1": {
              "type": "number"
            },
            "tickX2": {
              "type": "number"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          }
        },
        "brkLo": {
          "type": [
            "object",
            "null"
          ],
          "description": "두 선 사이 폭 표시 직선. 길이가 곧 퍼센트다.",
          "required": [
            "x",
            "y1",
            "y2",
            "tickX1",
            "tickX2",
            "tone"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y1": {
              "type": "number"
            },
            "y2": {
              "type": "number"
            },
            "tickX1": {
              "type": "number"
            },
            "tickX2": {
              "type": "number"
            },
            "tone": {
              "type": "string",
              "enum": [
                "hi",
                "lo"
              ]
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "제원 — 세대수|준공 / 전용㎡|층 / 세대당 주차. <span class=\"sep\">|</span> 로 구분. 주차 줄은 자료(apt-detail)가 있을 때만. 최대 4줄 — 주소 / 세대수|준공 / 전용|층 / 세대당 주차. 주소 줄은 2026-08-25 오너 지시로 맨 위에 붙었다. ⚠️ 여기를 늘릴 때는 빌더의 VB_H 도 같이 줄여야 한다 — 위가 늘면 곡선 판이 아랫줄을 덮는다(designQa svgspill).",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "station": {
      "type": [
        "object",
        "null"
      ],
      "description": "가장 가까운 지하철역. 코드(카카오 로컬)가 잰 값이 있을 때만 붙는다. 거리는 카드에 싣지 않는다(오너 2026-08-16).",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 20
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distanceM": {
          "type": "number"
        }
      }
    }
  }
}
