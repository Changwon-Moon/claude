{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "singo-record@1",
  "description": "오늘의 신고가 — 단지 한 곳이 기준선 이후 최고가를 새로 쓴 사건 한 건. 월별 최고가 곡선과 넘어선 10억 선을 함께 그린다. 좌표는 전부 빌더가 계산한다(템플릿은 그리기만).",
  "type": "object",
  "required": [
    "template",
    "title",
    "price",
    "spec",
    "chart",
    "source"
  ],
  "additionalProperties": true,
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^singo-record@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "kicker": {
      "type": "string",
      "maxLength": 48,
      "description": "오늘의 N억 클럽 가입 소식 (날짜). 돌파가 아니면 '클럽 가입'이라 쓰지 않는다."
    },
    "title": {
      "type": "string",
      "description": "지역(회색 .rg) + 단지명 + 평형. 한 줄."
    },
    "price": {
      "type": "string",
      "maxLength": 12,
      "description": "실거래가 (예: 20.7억). 이 판형에서 레드로 쓰는 자리."
    },
    "chart": {
      "type": "object",
      "required": [
        "vb",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "vb": {
          "type": "string"
        },
        "threshold": {
          "type": [
            "object",
            "null"
          ],
          "description": "넘어선 10억 선. 돌파가 아니면 null — 있지도 않은 문턱을 그리지 않는다.",
          "required": [
            "x1",
            "x2",
            "y",
            "tx",
            "ty",
            "text"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "tx": {
              "type": "number"
            },
            "ty": {
              "type": "number"
            },
            "text": {
              "type": "string"
            }
          }
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "description": "선 구간. 수집을 못 한 달에서 끊기므로 여러 개일 수 있다.",
          "items": {
            "type": "object",
            "required": [
              "d"
            ],
            "properties": {
              "d": {
                "type": "string"
              }
            }
          }
        },
        "dots": {
          "type": "array",
          "description": "실제 거래가 있던 달. 선은 관측 사이를 이은 것일 뿐이라 점이 있어야 한다.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "r"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "r": {
                "type": "number"
              }
            }
          }
        },
        "axis": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "text"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "anchor": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "dot": {
          "type": "object",
          "description": "오늘 거래. 카드에서 레드를 쓰는 유일한 자리. 라벨은 없다 — 위 큰 숫자가 이미 말한다.",
          "required": [
            "x",
            "y",
            "r",
            "rOuter"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "rOuter": {
              "type": "number"
            }
          }
        },
        "band": {
          "type": [
            "object",
            "null"
          ],
          "description": "문턱 위 영역(=N억 클럽 자리). 돌파가 아니면 null.",
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            }
          }
        },
        "floor": {
          "type": [
            "object",
            "null"
          ],
          "description": "바닥 가로선. y축이 0에서 시작하지 않으므로 보통 null 이다 — 있으면 0선으로 읽힌다.",
          "required": [
            "x1",
            "x2",
            "y"
          ],
          "properties": {
            "x1": {
              "type": "number"
            },
            "x2": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "old": {
          "type": [
            "object",
            "null"
          ],
          "description": "옛 고점 표식(빈 원 + 라벨). 아래 '지난 사이클 고점' 숫자를 그림에서 찾게 한다.",
          "required": [
            "x",
            "y",
            "r",
            "tx",
            "ty",
            "text"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "r": {
              "type": "number"
            },
            "tx": {
              "type": "number"
            },
            "ty": {
              "type": "number"
            },
            "anchor": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "description": "제원 두 줄 — 세대수|준공(년식) / 전용㎡|층. <span class=\"sep\">|</span> 로 구분.",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "cycle": {
      "type": [
        "object",
        "null"
      ],
      "description": "지난 사이클 고점. 최대 낙폭이 난 골 직전의 최고가 — 코드가 계산한다. 내림 구간이 없으면 null.",
      "required": [
        "peak",
        "when",
        "vs",
        "dir"
      ],
      "properties": {
        "peak": {
          "type": "string",
          "maxLength": 10
        },
        "when": {
          "type": "string",
          "maxLength": 12
        },
        "vs": {
          "type": "string",
          "maxLength": 10
        },
        "dir": {
          "type": "string",
          "enum": [
            "up",
            "down"
          ]
        }
      }
    }
  }
}
