{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "rail-line@1 — 수도권 예정 철도망 노선 카드(좌 노선도 · 우 일정)",
  "type": "object",
  "required": [
    "template",
    "date",
    "title",
    "n",
    "rail",
    "head",
    "prog",
    "facts",
    "eta",
    "source"
  ],
  "properties": {
    "template": {
      "const": "rail-line@1"
    },
    "date": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "tone": {
      "enum": [
        "go",
        "mid",
        "warn",
        "stop"
      ]
    },
    "lc": {
      "type": "string",
      "description": "노선 표시색 — metro-lines.json 카탈로그 값"
    },
    "n": {
      "type": "integer",
      "minimum": 2,
      "maximum": 18,
      "description": "노선도 행 수(레일 길이 계산용)"
    },
    "prog": {
      "type": "object",
      "required": [
        "value",
        "asOf",
        "width"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "width": {
          "type": "string"
        },
        "zero": {
          "type": "boolean"
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ]
    },
    "shared": {
      "type": "string",
      "description": "선로 공용 구간 — 없으면 각주를 안 그린다"
    },
    "rail": {
      "type": "object",
      "description": "본선 레일 위치(%) — 빌더가 행 인덱스로 계산",
      "required": [
        "top",
        "h"
      ],
      "properties": {
        "top": {
          "type": "string"
        },
        "h": {
          "type": "string"
        }
      }
    },
    "eta": {
      "type": "object",
      "description": "개통예상일 강조 카드",
      "required": [
        "was",
        "now"
      ],
      "properties": {
        "was": {
          "type": "string"
        },
        "now": {
          "type": "string"
        }
      }
    },
    "head": {
      "type": "array",
      "description": "분기 전(또는 전체) 역 행",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "cls": {
            "type": "string"
          },
          "prov": {
            "type": "string"
          },
          "xfer": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gap": {
            "type": "string"
          }
        }
      }
    },
    "split": {
      "type": "object",
      "description": "분기점 이후 좌우 두 갈래 — 왼쪽 본선 잔여, 오른쪽 지선",
      "properties": {
        "flex": {
          "type": "integer"
        },
        "main": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "cls": {
                "type": "string"
              },
              "prov": {
                "type": "string"
              },
              "xfer": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gap": {
                "type": "string"
              }
            }
          }
        },
        "branch": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "cls": {
                "type": "string"
              },
              "prov": {
                "type": "string"
              },
              "xfer": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gap": {
                "type": "string"
              }
            }
          }
        },
        "mainRail": {
          "type": [
            "object",
            "null"
          ]
        },
        "brRail": {
          "type": "object"
        },
        "con": {
          "type": "object"
        },
        "cols": {
          "type": "string"
        },
        "conMain": {
          "type": "boolean"
        },
        "conBranch": {
          "type": "boolean"
        }
      }
    },
    "etaBg": {
      "type": "string"
    },
    "etaGlow": {
      "type": "string"
    }
  }
}