{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "record-grid@1",
  "description": "하루에 쏟아진 '기록'을 6칸에 나열한다. 사건이 터진 날 쓰는 판형.",
  "type": "object",
  "required": ["template", "title", "cells", "source"],
  "properties": {
    "template": { "type": "string", "pattern": "^record-grid@\\d+$" },
    "date": { "type": "string" },
    "subtitle": { "type": "string", "maxLength": 40 },
    "title": { "type": "string" },
    "lead": {
      "type": "object",
      "description": "제목 아래 한 줄 — 오늘의 핵심 지수. 없으면 생략된다.",
      "required": ["label", "value"],
      "properties": {
        "label": { "type": "string", "maxLength": 20 },
        "value": { "type": "string", "maxLength": 16 },
        "delta": { "type": "string", "maxLength": 24 },
        "sub": { "type": "string", "maxLength": 40 }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["label", "value"],
        "properties": {
          "label": { "type": "string", "maxLength": 16 },
          "value": { "type": "string", "maxLength": 12 },
          "rank": { "type": "string", "maxLength": 10 },
          "prev": { "type": "string", "maxLength": 34 }
        }
      }
    },
    "note": { "type": "string", "maxLength": 80, "description": "맥락 한 줄. 카드 맨 아래 푸터 위." },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "asOf": { "type": "string" }
      }
    }
  }
}
