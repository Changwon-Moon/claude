{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "record-grid@1",
  "description": "하루에 쏟아진 '기록'을 장부처럼 쌓는다. 주인공은 기록 문구이고 수치는 증거다.",
  "type": "object",
  "required": [
    "template",
    "title",
    "cells",
    "source"
  ],
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^record-grid@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 40
    },
    "title": {
      "type": "string"
    },
    "lead": {
      "type": "object",
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "maxLength": 12
        },
        "value": {
          "type": "string",
          "maxLength": 14
        },
        "delta": {
          "type": "string",
          "maxLength": 30
        },
        "flag": {
          "type": "string",
          "maxLength": 8,
          "description": "국기 이모지"
        }
      }
    },
    "cells": {
      "type": "array",
      "minItems": 4,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "claim",
          "value"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "maxLength": 44,
            "description": "어떤 기록인가 — 이 카드의 주인공. <em>…</em> 로 감싼 낱말만 빨강"
          },
          "value": {
            "type": "string",
            "maxLength": 12,
            "description": "증거가 되는 수치. 회색 보조"
          },
          "prev": {
            "type": "string",
            "maxLength": 30,
            "description": "직전 기록·비교값. 없으면 생략"
          }
        }
      }
    },
    "note": {
      "type": "string",
      "maxLength": 80,
      "description": "맥락 한 줄. 카드 맨 아래 푸터 위."
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "badge": {
      "type": "string",
      "maxLength": 16,
      "description": "제목 위 뱃지 (날짜 등)"
    },
    "spark": {
      "type": "object",
      "required": [
        "points"
      ],
      "description": "지수 추이 꺾은선. 미수집 구간은 점선으로 긋는다.",
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "d",
              "c"
            ],
            "properties": {
              "d": {
                "type": "string"
              },
              "c": {
                "type": "number"
              }
            }
          }
        },
        "gapAfter": {
          "type": "string"
        },
        "gapUntil": {
          "type": "string"
        },
        "gapLabel": {
          "type": "string",
          "maxLength": 24
        },
        "from": {
          "type": "string"
        },
        "last": {
          "type": "object",
          "properties": {
            "d": {
              "type": "string"
            },
            "c": {
              "type": "number"
            },
            "label": {
              "type": "string"
            }
          }
        }
      }
    },
    "sparkJson": {
      "type": "string",
      "description": "spark 를 문자열로 담은 것 — 템플릿 스크립트가 읽는다"
    }
  }
}
