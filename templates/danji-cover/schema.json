{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "danji-cover@1",
  "description": "청약·분양 카드 **표준 판형**(오너 확정 2026-08-03). 표지(조감도→잉크 밴드에 제목·단지명·주소) + 종이 두 단(타입별 분양가 / 제원·일정 괘선 그리드) + 특이사항 + 푸터.",
  "type": "object",
  "required": [
    "template",
    "topcap",
    "titleLines",
    "danji",
    "source",
    "priceTable",
    "spec"
  ],
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^danji-cover@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "presale",
        "result",
        "remndr"
      ]
    },
    "topcap": {
      "type": "string",
      "maxLength": 40,
      "description": "고정 부제 + 기준 날짜. 빌더가 만든다 — 손으로 적으면 날짜가 굳는다"
    },
    "titleLines": {
      "type": "array",
      "description": "제목. 오너 지시로 **한 줄**이 기본이다(폰트를 최대로 키우기 위해)",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "hero": {
      "type": "object",
      "properties": {
        "photo": {
          "type": "string"
        },
        "credit": {
          "type": "string",
          "maxLength": 40
        },
        "placeholder": {
          "type": "boolean"
        },
        "fallbackColor": {
          "type": "string"
        },
        "fallbackWord": {
          "type": "string",
          "maxLength": 20
        },
        "shift": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000,
          "description": "표지 사진을 위로 끌어올릴 px. **빌더가 원본 크기에서 계산한다** — 손으로 적지 않는다 ⚠️ 2026-09-03 이후 빌더가 보내지 않는다 — 끌어올림은 object-position 이 한다."
        },
        "boxH": {
          "type": "integer",
          "minimum": 300,
          "maximum": 760,
          "description": "표지 사진 칸 높이(기본 446). 원본 세로가 허락하는 만큼만 키울 수 있다 ⚠️ 2026-09-03 이후 빌더가 보내지 않는다 — 끌어올림은 object-position 이 한다."
        },
        "coverH": {
          "type": "integer",
          "minimum": 560,
          "maximum": 1000,
          "description": "표지 최소 높이(기본 690)."
        },
        "fadeTop": {
          "type": "integer",
          "minimum": 100,
          "maximum": 800,
          "description": "잉크 번짐 시작 y — 빌더가 boxH-180 으로 계산한다 ⚠️ 2026-09-03 이후 빌더가 보내지 않는다 — 끌어올림은 object-position 이 한다."
        },
        "coverMax": {
          "type": "integer",
          "description": "표지가 늘어날 수 있는 한계 — 원본이 폭 1080 에서 갖는 높이 + 잉크 밴드. 그 위로는 사진을 늘리게 된다."
        }
      }
    },
    "danji": {
      "type": "object",
      "required": [
        "name"
      ],
      "description": "주소·시공사 줄은 오너 지시로 삭제됐다(2026-08-03). 이름과 브랜드 로고만 남는다",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 24
        },
        "logo": {
          "type": "string"
        },
        "logoColor": {
          "type": "string"
        },
        "company": {
          "type": "string",
          "maxLength": 20
        }
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "label",
          "date"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 10
          },
          "date": {
            "type": "string",
            "maxLength": 14
          },
          "tbd": {
            "type": "boolean"
          },
          "hi": {
            "type": "boolean",
            "description": "이 일정을 코발트로 — 무순위 접수처럼 '그날 하루'가 카드의 핵심일 때만"
          }
        }
      },
      "description": "청약 일정 — 특공·1순위·당첨자 발표·입주 예정(오너 지시 2026-08-03, 4칸)"
    },
    "notice": {
      "type": "string",
      "maxLength": 160,
      "description": "특이사항 한 줄 — 분상제·전매제한 등. 항목 앞 아이콘 마크업(<i class=\"em\">)을 포함하므로 길이가 글자 수보다 길다"
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        },
        "photo": {
          "type": "string",
          "maxLength": 30,
          "description": "조감도 출처. 사진 위 표기는 오너 지시로 삭제했고 푸터 출처 줄에 남긴다 — 건설사 저작물이라 표기 자체를 없애지는 않는다"
        }
      }
    },
    "priceTable": {
      "type": "object",
      "required": [
        "head",
        "rows",
        "cols"
      ],
      "description": "평형별 대표타입 표 — 면적대마다 타입 하나씩, 전부 적는다(오너 지시 2026-08-03)",
      "properties": {
        "head": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 24
          },
          "minItems": 0,
          "maxItems": 1,
          "description": "표 위 회색 머리글. 빈 배열이면 줄 자체를 그리지 않는다(오너 지시 2026-08-06)"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "area",
              "price"
            ],
            "properties": {
              "area": {
                "type": "string",
                "maxLength": 10
              },
              "price": {
                "type": "string",
                "maxLength": 12
              },
              "main": {
                "type": "boolean",
                "description": "주력 면적대 — 한 줄만 코발트"
              }
            }
          }
        },
        "note": {
          "type": "string",
          "maxLength": 20
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "가격판 열 수 — 코드가 값의 길이로 정한다(분양가는 4 이하, 무순위 '잔여 세대'는 5까지 한 줄)"
        }
      }
    },
    "spec": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4,
      "description": "제원 3분할 — 전부 순수 수치. 문장형 값을 섞으면 공통 fit 에서 큰 숫자가 끌려 내려간다. 타입별 분양가를 아는 무순위 카드만 4칸(specFour)이고, 이때 label 없이 above+value 로 쓴다",
      "items": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 12
          },
          "value": {
            "type": "string",
            "maxLength": 10
          },
          "unit": {
            "type": "string",
            "maxLength": 6
          },
          "breakdown": {
            "type": "string",
            "maxLength": 40,
            "description": "값 아래 회색 괄호 내역"
          },
          "pre": {
            "type": "string",
            "maxLength": 6,
            "description": "값 앞에 붙는 회색 수식어('최고'). 라벨 줄을 지운 판형에서 값의 뜻을 지킨다"
          },
          "tbd": {
            "type": "boolean",
            "description": "아직 못 채운 값('미고지') — 회색으로 눕힌다"
          },
          "above": {
            "type": "string",
            "maxLength": 24,
            "description": "값 위에 붙는 회색 한 줄('총 1,640세대 중')"
          },
          "hi": {
            "type": "boolean",
            "description": "값의 숫자를 코발트로 — 카드의 강조 한 군데"
          }
        }
      }
    },
    "address": {
      "type": "string",
      "maxLength": 40,
      "description": "조감도 바로 아래 붙는 주소(읍면동까지)"
    },
    "specFour": {
      "type": "boolean",
      "description": "제원 줄을 균등 4등분으로 — 타입이 넷인 무순위 카드"
    },
    "scale": {
      "type": "boolean",
      "description": "규모 우선 판 — 종이의 남는 세로를 위아래로 나눈다"
    },
    "noteSmall": {
      "type": "boolean",
      "description": "최하단 문구를 한 급 작게(34→30px). 옵트인 — 없으면 종전 크기."
    }
  }
}
