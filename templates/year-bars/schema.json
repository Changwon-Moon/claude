{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "year-bars@2",
  "description": "연도 가로축 · 세로 막대 변화율 추이. 0선 기준으로 위(오름)/아래(내림). 마지막 연도는 실측+추정 2단으로 쌓을 수 있다.",
  "type": "object",
  "required": [
    "template",
    "title",
    "zeroAt",
    "points",
    "source"
  ],
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^year-bars@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 70
    },
    "title": {
      "type": "string",
      "maxLength": 90,
      "description": "한 줄. 폭(936px)에 맞게 템플릿이 폰트를 자동 축소한다(줄이는 방향만). <span class=\"hi\">…</span> 으로 일부를 레드 강조할 수 있어 태그까지 세면 길어진다 — 보이는 글자는 30자 안쪽으로 쓴다"
    },
    "zeroAt": {
      "type": "string",
      "description": "0선의 위치(플롯 높이 대비 %). 빌더가 최대 오름/내림 비율로 계산"
    },
    "colGap": {
      "type": "string",
      "description": "막대 간격. 기본 12px"
    },
    "splitAt": {
      "type": "string",
      "description": "실측/추정 경계 세로 점선 위치(%). 추정이 있을 때만"
    },
    "arrow": {
      "type": "boolean",
      "description": "빈 공간을 지나 추정치 카드로 향하는 우상향 곡선(장식). 막대 뒤 레이어"
    },
    "stamp": {
      "type": "boolean",
      "description": "0선 아래 빈 칸(후반 연도 밑)의 wirit 워터마크"
    },
    "stamp2": {
      "type": "boolean",
      "description": "지수 곡선 아래·막대 위 빈 칸의 wirit 워터마크. 초년도 막대가 0선 아래에만 있을 때만 켠다 — 아니면 막대를 덮는다"
    },
    "points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "year",
          "value",
          "dir",
          "h",
          "totalH"
        ],
        "properties": {
          "year": {
            "type": "string",
            "maxLength": 6
          },
          "value": {
            "type": "string",
            "maxLength": 10,
            "description": "표시 문자열. 부호·단위까지 코드에서 완성"
          },
          "dir": {
            "enum": [
              "up",
              "down"
            ]
          },
          "h": {
            "type": "string",
            "description": "실측 막대 높이(플롯 대비 %)"
          },
          "hEst": {
            "type": "string",
            "description": "추정 막대 높이(실측 위에 쌓임). 있으면 점선+사선으로 그려진다"
          },
          "totalH": {
            "type": "string",
            "description": "실측+추정 합. 값 라벨을 막대 위에 올리는 데 쓴다"
          },
          "tag": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string",
              "maxLength": 6
            },
            "description": "추정 막대에 붙는 정사각 2줄 꼬리표(예: ['하반기','추정']). 1줄 알약형은 막대보다 넓어 지수 곡선과 겹친다"
          },
          "solidValue": {
            "type": "string",
            "maxLength": 8,
            "description": "실측 부분의 값. 추정이 위에 쌓인 칸에서 '어디까지가 실측인지'를 숫자로 보여준다"
          },
          "card": {
            "type": "object",
            "description": "그 칸의 값 라벨을 대신하는 배지 카드. 추정 연도에만 쓴다(점선+사선 = 추정 막대와 같은 언어). tag 에 '추정'이, note 에 산술 가정이 반드시 들어가야 한다.",
            "required": [
              "tag",
              "value",
              "note"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "maxLength": 14
              },
              "value": {
                "type": "string",
                "maxLength": 10
              },
              "note": {
                "type": "string",
                "maxLength": 30
              }
            }
          },
          "peak": {
            "type": "boolean",
            "description": "최고 실측 연도 1개만. 강조는 한 곳."
          },
          "valueInside": {
            "type": "boolean",
            "description": "값 라벨을 막대 안(흰 글씨)에 넣는다. 막대 위 자리가 지수 곡선과 겹칠 때만 — 빌더가 실측 거리로 정한다"
          }
        }
      }
    },
    "side": {
      "type": "object",
      "description": "제목 아래·플롯 좌상단에 좌우로 놓는 강조 카드(2026-07-30 3차). 최대 2장.",
      "properties": {
        "cards": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "style",
              "lines",
              "value"
            ],
            "properties": {
              "style": {
                "type": "string",
                "enum": [
                  "est",
                  "idx"
                ],
                "description": "그래프 요소와 색을 맞춘다. est = 추정 막대(레드·점선·사선) / idx = 지수 곡선(회색 테두리). est 는 점선·사선을 절대 실선/단색으로 바꾸지 않는다 — 추정이 실측으로 읽힌다"
              },
              "lines": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "maxLength": 14
                },
                "description": "라벨 2줄. 카드가 정사각형이라 줄 수가 고정이어야 한다 — 자동 줄바꿈에 맡기면 4줄이 돼 정사각형을 넘친다"
              },
              "value": {
                "type": "string",
                "maxLength": 10,
                "description": "3번째 줄. 레드·크게. 이 카드가 말하려는 한 숫자다"
              },
              "small": {
                "type": "string",
                "maxLength": 8,
                "description": "값 뒤 작은 글씨(예: (추정)). style 이 est 면 '추정' 표기가 반드시 있어야 한다"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "dense": {
      "type": "boolean",
      "description": "칸이 많을 때(13칸 이상) 축·값 글자를 한 단 줄인다. 안 주면 기존 카드와 동일한 픽셀."
    },
    "topLine": {
      "type": "object",
      "description": "막대칸 **위에 따로 놓는** 꺾은선 칸(선택). 안 주면 안 그려진다 — 기존 카드 픽셀 불변. 인원(명)과 비중(%)처럼 단위가 다른 두 값을 겹치지 않고 위아래로 나눠 보여줄 때 쓴다. 가로축(연도)만 아래 막대칸과 공유하고 세로 눈금은 각자 갖는다. 좌표는 전부 빌더가 계산한다.",
      "required": [
        "points"
      ],
      "properties": {
        "height": {
          "type": "string",
          "description": "이 칸의 높이. 기본 292px. 여기서 쓴 만큼 아래 막대칸이 줄어든다."
        },
        "caption": {
          "type": "string",
          "maxLength": 60,
          "description": "칸 좌상단 한 줄. 이 선이 무엇의 비중인지·분모가 무엇인지 밝힌다. <b>…</b> 로 일부를 잉크색으로."
        },
        "points": {
          "type": "string",
          "description": "polyline 좌표(viewBox 1000×1000, preserveAspectRatio=none). 빌더가 계산."
        },
        "area": {
          "type": "string",
          "description": "선 아래 옅은 면(선택). polygon 좌표."
        },
        "dots": {
          "type": "array",
          "description": "연도 점. on:true 면 채운 원(끝점 강조).",
          "items": {
            "type": "object",
            "required": [
              "cx",
              "cy"
            ],
            "properties": {
              "cx": {
                "type": "number"
              },
              "cy": {
                "type": "number"
              },
              "on": {
                "type": "boolean"
              }
            }
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 4,
          "description": "선 위 값 라벨. 양 끝만 단다 — 가운데까지 달면 선이 글자에 묻힌다.",
          "items": {
            "type": "object",
            "required": [
              "x",
              "y",
              "text"
            ],
            "properties": {
              "x": {
                "type": "string"
              },
              "y": {
                "type": "string"
              },
              "text": {
                "type": "string",
                "maxLength": 12
              },
              "dim": {
                "type": "boolean",
                "description": "회색으로(시작점처럼 주인공이 아닌 값)"
              },
              "anchor": {
                "enum": [
                  "start",
                  "end"
                ],
                "description": "라벨 정렬. 기본은 점 위 가운데. 양 끝 칸은 가운데로 두면 카드 밖으로 나가므로 start/end 로 안쪽에 붙인다."
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}