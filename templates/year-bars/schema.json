{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "year-bars@1",
  "description": "연도별 변화율 발산 막대. 0 축을 기준으로 하락은 왼쪽, 상승은 오른쪽. 연속 구간(그룹)으로 방향 전환을 보여준다.",
  "type": "object",
  "required": ["template", "title", "groups", "source"],
  "properties": {
    "template": { "type": "string", "pattern": "^year-bars@\\d+$" },
    "date": { "type": "string" },
    "subtitle": { "type": "string", "maxLength": 60, "description": "상단 캡션(공용 topcap)" },
    "title": { "type": "string", "maxLength": 44, "description": "줄바꿈(\\n) 허용" },
    "lede": { "type": "string", "maxLength": 60 },
    "many": { "type": "boolean", "description": "행이 많을 때 트랙을 좁힌다(12행 이상 권장)" },
    "negLabel": { "type": "string", "maxLength": 8, "description": "왼쪽 축 라벨. 기본 '하락'" },
    "posLabel": { "type": "string", "maxLength": 8, "description": "오른쪽 축 라벨. 기본 '상승'" },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "연속 구간. 구간을 나누는 것 자체가 '몇 년 연속'이라는 정보다.",
      "items": {
        "type": "object",
        "required": ["tone", "rows"],
        "properties": {
          "tone": { "enum": ["neg", "pos"], "description": "구간의 색 계열. neg=코발트, pos=레드" },
          "label": { "type": "string", "maxLength": 16, "description": "왼쪽 세로 라벨(예: '5년 연속 하락')" },
          "split": { "type": "string", "maxLength": 18, "description": "이 구간 **앞**에 넣을 굵은 구분선의 칩 문구" },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "items": {
              "type": "object",
              "required": ["year", "value", "dir", "w"],
              "properties": {
                "year": { "type": "string", "maxLength": 6 },
                "value": { "type": "string", "maxLength": 10, "description": "표시 문자열. 부호·단위까지 코드에서 완성해 넣는다" },
                "dir": { "enum": ["neg", "pos"] },
                "w": { "type": "number", "minimum": 0, "maximum": 100, "description": "트랙 대비 막대 폭(%). 최대 절대값이 100이 되게 코드가 계산한다" },
                "note": { "type": "string", "maxLength": 12, "description": "값 아래 작은 글씨(예: '6월까지')" },
                "max": { "type": "boolean", "description": "최대 상승 연도 1개만. 강조는 한 곳." },
                "partial": { "type": "boolean", "description": "아직 끝나지 않은 연도 — 막대를 사선으로 칠해 그래픽만 잘라 써도 경고가 남는다" }
              }
            }
          }
        }
      }
    },
    "foot": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["k", "v"],
        "properties": {
          "k": { "type": "string", "maxLength": 20 },
          "v": { "type": "string", "maxLength": 16 },
          "accent": { "type": "boolean" }
        }
      }
    },
    "caveat": { "type": "string", "maxLength": 140, "description": "정직 문구. 기준·한계를 반드시 적는다" },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "asOf": { "type": "string" } }
    }
  },
  "additionalProperties": true
}
