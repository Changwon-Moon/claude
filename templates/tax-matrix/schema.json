{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["template", "who", "status", "title", "cols", "rows", "source"],
  "properties": {
    "template": { "type": "string" },
    "date": { "type": "string" },
    "who": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "lead": { "type": "string" },
    "n": { "type": "integer", "minimum": 1 },
    "labw": { "type": "integer", "minimum": 100 },
    "hero": { "type": "boolean" },
    "cols": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "cells"],
        "properties": {
          "label": { "type": "string" },
          "note": { "type": "string" },
          "cells": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["v"],
              "properties": {
                "v": { "type": "string" },
                "unit": { "type": "string" },
                "cls": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "foot": { "type": "string" },
    "applyAt": { "type": "string" },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": { "name": { "type": "string" }, "asOf": { "type": "string" } },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
