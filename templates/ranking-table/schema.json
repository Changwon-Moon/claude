{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ranking-table@1",
  "description": "순위표 카드. 로고+이름+값(1~2열). 항목 3~15개.",
  "type": "object",
  "required": ["template", "title", "nameLabel", "valueLabel", "items", "source"],
  "properties": {
    "template": { "type": "string", "pattern": "^ranking-table@\\d+$" },
    "date": { "type": "string" },
    "variant": { "enum": ["a", "b", "c"], "description": "시안 선택. 확정 후 하나로 고정." },
    "badge": { "type": "string", "maxLength": 22 },
    "title": { "type": "string", "maxLength": 34 },
    "subtitle": { "type": "string", "maxLength": 60 },
    "nameLabel": { "type": "string", "maxLength": 12 },
    "valueLabel": { "type": "string", "maxLength": 14 },
    "subLabel": { "type": "string", "maxLength": 14 },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "maxLength": 24 },
          "value": { "type": "string", "maxLength": 16 },
          "sub": { "type": "string", "maxLength": 16 },
          "rank": { "type": "string", "maxLength": 6, "description": "명시 순위(공동순위 표기용). 없으면 행 번호 자동." },
          "logo": { "type": "string", "description": "로고 slug (_shared/logos/{slug}.{ext})" },
          "logoExt": { "type": "string", "enum": ["svg", "png"], "description": "로고 확장자. 없으면 svg." },
          "logoColor": { "type": "string", "description": "브랜드색 hex. 실제 로고 없을 때 컬러칩 배경." },
          "logoText": { "type": "string", "maxLength": 4, "description": "칩 약칭. 없으면 첫 글자." }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "asOf": { "type": "string" }
      }
    },
    "photoStrip": {
      "type": "array",
      "maxItems": 3,
      "description": "하단 3분할 사진. photo(허브 등록 파일명) 있으면 실사진, 없으면 그래픽 플레이스홀더",
      "items": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "maxLength": 24 },
          "photo": { "type": "string" },
          "color": { "type": "string" }
        }
      }
    }
  }
}
