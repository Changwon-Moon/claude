{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "daso-treemap@1",
  "description": "오른쪽은 라벨 줄 + 가로막대(1채 vs 2채 이상) + 확대 깔때기 + 그 토막을 확대한 트리맵, 왼쪽은 표. ⚠️ 칸의 넓이는 '2채 이상' 안에서의 비중이고 칸에 적힌 %는 전체 소유자 기준 공표값이다 — 분모가 둘이므로 확대라는 사실을 깔때기(funnel)가 그림으로 말해야 한다(설명 문장으로 대신하지 않는다, 오너 2026-09-07). 칸 안에 글자 자리가 없으면 라벨을 넣지 않고 옆 표가 그 값을 받는다 — 억지로 지시선을 뽑아 채우면 그림이 「다 비슷하다」고 거짓말을 한다.",
  "type": "object",
  "required": [
    "template",
    "title",
    "plot",
    "tiles",
    "table",
    "source"
  ],
  "properties": {
    "template": {
      "type": "string",
      "pattern": "^daso-treemap@\\d+$"
    },
    "date": {
      "type": "string"
    },
    "subtitle": {
      "type": "string",
      "maxLength": 44
    },
    "title": {
      "type": "string"
    },
    "plot": {
      "type": "object",
      "description": "오른쪽 칸 전체의 픽셀 크기(h 는 막대+확대라벨+트리맵을 합친 높이)와 표와의 간격. 빌더는 h 에서 막대와 확대라벨 높이를 빼고 남은 것으로 칸 크기를 재므로 템플릿과 반드시 같아야 한다.",
      "required": [
        "w",
        "h",
        "gap"
      ],
      "properties": {
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "gap": {
          "type": "number",
          "description": "트리맵과 표 사이 간격(px)"
        },
        "side": {
          "type": "string",
          "enum": [
            "right"
          ],
          "description": "'right' 면 트리맵이 오른쪽·표가 왼쪽(row-reverse). 없으면 트리맵이 왼쪽."
        }
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "x",
          "y",
          "w",
          "h",
          "bg",
          "fg"
        ],
        "properties": {
          "x": {
            "type": "number",
            "description": "왼쪽 (판 대비 %)"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number"
          },
          "h": {
            "type": "number"
          },
          "bg": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "fg": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "label": {
            "type": "string",
            "maxLength": 14,
            "description": "없으면 라벨을 안 그린다(칸이 좁다는 뜻)"
          },
          "value": {
            "type": "string",
            "maxLength": 10,
            "description": "없으면 채수만 그린다(칸이 값까지 담기엔 좁다는 뜻)"
          },
          "lbPx": {
            "type": "number"
          },
          "vlPx": {
            "type": "number"
          },
          "pdPx": {
            "type": "number",
            "description": "칸 안쪽 여백(px) — 등급마다 다르다"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "description": "판 아래 굵은 한 줄. <b>…</b> 로 감싼 낱말만 코발트"
    },
    "source": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "asOf": {
          "type": "string"
        }
      }
    },
    "table": {
      "type": "object",
      "description": "오른쪽 표 — 트리맵이 크기를 보여 주고 이 표가 값을 읽게 한다. 색칩이 둘을 잇는다. 머리글과 행이 같은 grid(cols) 를 쓰므로 열이 어긋날 수 없다.",
      "required": [
        "cols",
        "head",
        "rows",
        "rowH",
        "rowFlex",
        "hdPx",
        "nmPx",
        "v1Px"
      ],
      "properties": {
        "cols": {
          "type": "string",
          "description": "grid-template-columns 값. 이름 열만 1fr 이고 나머지는 고정폭 — auto 열을 두면 행마다 폭이 달라져 세로선이 어긋난다."
        },
        "head": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 10
          }
        },
        "rowH": {
          "type": "number"
        },
        "rowFlex": {
          "type": "string",
          "description": "행이 적을 때 세로를 채우려고 늘린다(\"1 1 0\"), 많으면 \"0 0 auto\""
        },
        "hdPx": {
          "type": "number"
        },
        "nmPx": {
          "type": "number"
        },
        "v1Px": {
          "type": "number"
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "label",
              "v1",
              "bg"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 12
              },
              "v1": {
                "type": "string",
                "maxLength": 10
              },
              "bg": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "grp": {
                "type": "boolean",
                "description": "트리맵에서 한 칸으로 묶인 행 — 템플릿이 왼쪽에 묶음선을 그린다"
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "description": "각주 — ※ 로 시작하는 용어 풀이를 한 줄씩. <b>…</b> 로 용어를 굵게. 한 문단으로 흘리지 않는다(오너 2026-09-07).",
      "items": {
        "type": "string",
        "maxLength": 120
      }
    },
    "bar": {
      "type": "object",
      "description": "오른쪽 위 라벨 줄 + 가로막대. 소유자 100명을 1채 / 2채 이상으로 가른다. 글자는 막대 안이 아니라 위 라벨 줄에 있다 — 좁은 토막 안에서는 두 글자를 같은 크기로 키울 수 없기 때문이다.",
      "required": [
        "labH",
        "h",
        "gap",
        "labels",
        "segments"
      ],
      "properties": {
        "labH": {
          "type": "number",
          "description": "라벨 줄 높이(px)"
        },
        "h": {
          "type": "number",
          "description": "막대 높이(px)"
        },
        "gap": {
          "type": "number",
          "description": "라벨 줄과 막대 사이(px)"
        },
        "labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "cls",
              "name",
              "value",
              "nmPx",
              "vlPx"
            ],
            "properties": {
              "cls": {
                "type": "string",
                "enum": [
                  "one",
                  "two"
                ],
                "description": "one=왼쪽(잉크) · two=오른쪽(코발트)"
              },
              "name": {
                "type": "string",
                "maxLength": 12
              },
              "value": {
                "type": "string",
                "maxLength": 10
              },
              "nmPx": {
                "type": "number"
              },
              "vlPx": {
                "type": "number"
              }
            }
          }
        },
        "segments": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "w",
              "bg"
            ],
            "properties": {
              "w": {
                "type": "number",
                "description": "막대 대비 %. 합이 100이어야 한다"
              },
              "bg": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        }
      }
    },
    "funnel": {
      "type": "object",
      "description": "확대 깔때기. **빠뜨리면 안 된다** — 칸의 넓이(2채 이상 기준)와 적힌 %(전체 기준)의 분모가 다르다는 사실을 카드 위에서 말하는 유일한 표현이다. 위 변은 확대 대상 토막의 좌우, 아래 변은 트리맵의 좌우.",
      "required": [
        "h",
        "bg",
        "bg2",
        "clip"
      ],
      "properties": {
        "h": {
          "type": "number"
        },
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "위 변 색 — 확대 대상 토막과 같은 색"
        },
        "clip": {
          "type": "string",
          "description": "clip-path: polygon(…) 안에 그대로 들어가는 좌표 목록"
        },
        "bg2": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "description": "아래 변 색 — 트리맵 첫 칸과 같은 색. 둘 사이를 세로 그러데이션으로 흘린다"
        }
      }
    }
  }
}
