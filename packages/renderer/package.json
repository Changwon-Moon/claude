{
  "name": "@wirit/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "콘텐츠 JSON을 인스타 카드(PNG)로 렌더링. 동일 입력 = 동일 픽셀(결정적).",
  "bin": {
    "wirit-render": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "render": "tsx src/cli.ts",
    "test:sample": "tsx src/cli.ts --data ../../templates/dummy-card/sample.json --out ../../data/out"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "handlebars": "^4.7.8",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
